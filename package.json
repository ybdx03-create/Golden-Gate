{
  "name": "golden-gate",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "db:setup": "node scripts/setup-db.mjs",
    "start:server": "tsx server/index.ts",
    "test": "tsx --test server/*.test.ts",
    "test:integration": "node scripts/smoke-test.mjs",
    "format": "prettier --write README.md docs index.html package.json scripts server src tsconfig.json vite.config.ts",
    "format:check": "prettier --check README.md docs index.html package.json scripts server src tsconfig.json vite.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ybdx03-create/Golden-Gate.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ybdx03-create/Golden-Gate/issues"
  },
  "homepage": "https://github.com/ybdx03-create/Golden-Gate#readme",
  "description": "",
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
